# LM Studio (OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=lm-studio
# Append /no_think to user turns (Qwen3 speed-up). 0 to disable.
LLM_NO_THINK=1
JARVIS_HISTORY_TURNS=6

# faster-whisper: tiny/base/small/medium...; device auto|cuda|cpu
# small = better accuracy (default); base = faster on weak PCs. CPU always uses int8.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=en

# Naming (see README: Renaming your assistant)
# What the assistant calls itself (system prompt, greeting, console). Default Jarvis.
ASSISTANT_NAME=Jarvis
# What it calls you, e.g. sir, madam, boss, captain. Leave blank for no title.
USER_TITLE=sir
# Wake word model: built-in openwakeword name (hey_jarvis, alexa, hey_mycroft, hey_rhasspy)
# or a path to a custom-trained .onnx file (relative paths are from this folder).
# Changing ASSISTANT_NAME does NOT change the wake word.
JARVIS_WAKE_MODEL=hey_jarvis

# Audio / wake word
JARVIS_WAKE_THRESHOLD=0.5
# Two-tone chime when the wake word is heard (0 = off) and its volume 0.0-1.0
JARVIS_WAKE_SOUND=1
JARVIS_WAKE_SOUND_VOLUME=0.3
# Barge-in: say the wake word while it's talking to cut it off (0 = off).
# Uses a stricter threshold so its own voice doesn't trigger it; headphones work best.
JARVIS_BARGE_IN=1
JARVIS_BARGE_IN_THRESHOLD=0.7
# How long to wait after you stop talking before ending the recording. Lower = snappier; too low cuts you off.
JARVIS_SILENCE_SECONDS=0.75
JARVIS_MAX_RECORD_SECONDS=10
JARVIS_VAD_RMS=500
# Optional mic index or name substring (python jarvis_assistant.py --setup lists mics)
JARVIS_INPUT_DEVICE=

# ElevenLabs (optional; falls back to pyttsx3 if blank)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Voice engine: elevenlabs | kokoro | windows. Leave blank for automatic
# (ElevenLabs if a key is set, else Kokoro if installed, else the Windows voice).
# If the chosen engine fails it falls back: ElevenLabs -> Kokoro -> Windows voice.
JARVIS_TTS_ENGINE=
# Kokoro (free offline voice; pip install -r requirements-kokoro.txt). British voices:
# bm_george, bm_lewis, bm_daniel, bm_fable (male), bf_emma, bf_isabella, bf_alice, bf_lily (female)
KOKORO_VOICE=bm_george
# auto | cpu | cuda  (auto uses the graphics card if PyTorch can see it)
KOKORO_DEVICE=auto

# Follow-up mode: after a reply, listen this many seconds without the wake word (0 = off)
JARVIS_FOLLOWUP_SECONDS=6
# Comma-separated phrases that end follow-up mode
JARVIS_FOLLOWUP_END_PHRASES=thanks,thank you,that's all,that is all,never mind,nevermind,goodbye,bye,no thanks,that will be all

# Pause mode ("<wake word>, stop listening"). Saying the wake word resumes.
# Pressing 'p' in the console window also toggles pause (Windows).
JARVIS_PAUSE_PHRASES=stop listening,go to sleep,mute yourself,pause listening

# Built-in Windows voice (used when ElevenLabs isn't set up)
# JARVIS_VOICE: part of an installed voice's name, e.g. david or zira
JARVIS_VOICE=david
# Speaking speed in words per minute (about 200 is normal)
JARVIS_VOICE_RATE=185
# Volume from 0.0 to 1.0
JARVIS_VOICE_VOLUME=1.0
# Closing lines after answers: separate several with | and one is picked at random each time.
# Leave this line out to use the built-in list; set it blank to turn closings off.
# JARVIS_CLOSING_PHRASE=Let me know if you need anything else.|Standing by.|Happy to help.

# OBS Studio control (OBS 28+: Tools > WebSocket Server Settings)
OBS_HOST=localhost
OBS_PORT=4455
# Blank if authentication is turned off in OBS
OBS_PASSWORD=
# Name of your mic's audio input in OBS (Audio Mixer)
OBS_MIC_INPUT=Mic/Aux

# Wake sound style: bell, warp, comms, cosmos, chug (metal palm mute), chime3, sonar, powerup, chirp, blip, beep (original); instruments: piano, acoustic_guitar, harp, violin, cello, trumpet, sax, flute, clarinet, marimba, xylophone, vibraphone, steel_drum, kalimba, music_box, banjo, sitar, synth_lead, organ, taiko; radios: radio_click, roger_beep, talkabout, police_radio, cb_radio, ham_radio, military_radio, squelch_tail; or random (a different one each wake).
# Run `python jarvis_assistant.py --sounds` to preview them. If you change the sound by voice
# ("change your sound to piano"), it's saved in .cache/settings.json and overrides this line.
JARVIS_WAKE_SOUND_STYLE=bell
# Or use your own short .wav file (path, relative to this folder is fine). Overrides the style.
# JARVIS_WAKE_SOUND_FILE=sounds/my_chime.wav
# Seconds of silence before each wake sound. USB/Bluetooth headphones can swallow the first moment of a short
# sound; raise this (e.g. 0.4) if a sound seems missing, or 0 to turn it off.
# JARVIS_WAKE_SOUND_PREROLL=0.2
# Change songs silently (1) or have him say "Next track." (0)
JARVIS_QUIET_MEDIA=1

# Gaming mode (0/1): Whisper + Kokoro on CPU, smaller Whisper model, below-normal priority, no barge-in.
# Also toggled by the Assistant-tab switch or by saying "gaming mode on/off" (saved in .cache/settings.json,
# which overrides this line). Model/device changes apply after a restart.
JARVIS_GAMING_MODE=0
# Whisper model used while gaming mode is on
JARVIS_GAMING_WHISPER_MODEL=base
