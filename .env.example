# LM Studio (OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=lm-studio
# Append /no_think to user turns (Qwen3 speed-up). 0 to disable.
LLM_NO_THINK=1
JARVIS_HISTORY_TURNS=6

# faster-whisper: tiny/base/small/medium...; device auto|cuda|cpu
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=en

# Naming (see README: Renaming your assistant)
# What the assistant calls itself (system prompt, greeting, console). Default Jarvis.
ASSISTANT_NAME=Jarvis
# What it calls you, e.g. sir, madam, boss, captain. Leave blank for no title.
USER_TITLE=sir
# Wake word model: built-in openwakeword name (hey_jarvis, alexa, hey_mycroft, hey_rhasspy)
# or a path to a custom-trained .onnx file (relative paths are from this folder).
# Changing ASSISTANT_NAME does NOT change the wake word.
JARVIS_WAKE_MODEL=hey_jarvis

# Audio / wake word
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_SILENCE_SECONDS=1.2
JARVIS_MAX_RECORD_SECONDS=10
JARVIS_VAD_RMS=500
# Optional mic index or name substring
JARVIS_INPUT_DEVICE=

# ElevenLabs (optional; falls back to pyttsx3 if blank)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Follow-up mode: after a reply, listen this many seconds without the wake word (0 = off)
JARVIS_FOLLOWUP_SECONDS=6
# Comma-separated phrases that end follow-up mode
JARVIS_FOLLOWUP_END_PHRASES=thanks,thank you,that's all,that is all,never mind,nevermind,goodbye,bye,no thanks,that will be all

# Pause mode ("<wake word>, stop listening"). Saying the wake word resumes.
# Pressing 'p' in the console window also toggles pause (Windows).
JARVIS_PAUSE_PHRASES=stop listening,go to sleep,mute yourself,pause listening

# Built-in Windows voice (used when ElevenLabs isn't set up)
# JARVIS_VOICE: part of an installed voice's name, e.g. david or zira
JARVIS_VOICE=david
# Speaking speed in words per minute (about 200 is normal)
JARVIS_VOICE_RATE=185
# Volume from 0.0 to 1.0
JARVIS_VOICE_VOLUME=1.0
# Closing lines after answers: separate several with | and one is picked at random each time.
# Leave this line out to use the built-in list; set it blank to turn closings off.
# JARVIS_CLOSING_PHRASE=Let me know if you need anything else.|Standing by.|Happy to help.

# OBS Studio control (OBS 28+: Tools > WebSocket Server Settings)
OBS_HOST=localhost
OBS_PORT=4455
# Blank if authentication is turned off in OBS
OBS_PASSWORD=
# Name of your mic's audio input in OBS (Audio Mixer)
OBS_MIC_INPUT=Mic/Aux
